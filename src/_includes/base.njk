<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {# Política de seguridad de contenido. Va en <meta> porque GitHub Pages no
     deja configurar cabeceras HTTP propias. Efecto real: si alguien lograra
     inyectar marcado en este sitio, el navegador no ejecutaría el script que
     traiga, no dejaría que la página se conecte a ningún servidor ajeno y no
     permitiría reapuntar el formulario a otro destino.
     Nota para el futuro: 'script-src self' significa que cualquier script
     nuevo tiene que vivir en /js/ del propio sitio. Si algún día se agrega
     analítica externa (GoatCounter, por ejemplo), hay que sumar su dominio
     aquí o no va a cargar. frame-ancestors no se pone: el navegador lo
     ignora cuando viene por <meta>, así que sería una falsa tranquilidad. #}
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; connect-src https://tuaccesible.goatcounter.com; script-src 'self'; style-src 'self'; img-src 'self' data: https://tuaccesible.goatcounter.com; font-src 'self'; form-action https://api.web3forms.com; upgrade-insecure-requests">
  <meta name="referrer" content="strict-origin-when-cross-origin">

  <title>{{ title }} · tuaccesible.com</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  {% if noindex %}<meta name="robots" content="noindex, follow">{% endif %}

  <link rel="alternate" hreflang="{{ lang }}" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" hreflang="{% if lang == 'en' %}es{% else %}en{% endif %}" href="{{ site.url }}{{ altUrl }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}/">

  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/img/icono-180.png">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="tuaccesible">
  <meta property="og:title" content="{{ title }} · tuaccesible.com">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="{% if lang == 'en' %}en_US{% else %}es_ES{% endif %}">
  <meta property="og:image" content="{{ site.url }}/img/og-tuaccesible.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{% if lang == 'en' %}tuaccesible. Digital accessibility consulting.{% else %}tuaccesible. Consultoría en accesibilidad digital.{% endif %}">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="stylesheet" href="/css/global.css">
</head>
<body>
  <a class="skip-link" href="#contenido-principal">{% if lang == 'en' %}Skip to main content{% else %}Saltar al contenido principal{% endif %}</a>

  {% if lang == 'en' %}
    {% set navItems = [
      {url: "/en/", label: "Home"},
      {url: "/en/services/", label: "Services"},
      {url: "/en/regulations/", label: "Regulations"},
      {url: "/en/about/", label: "About"},
      {url: "/en/team/", label: "Team"},
      {url: "/en/testimonials/", label: "Case work"},
      {url: "/en/contact/", label: "Contact"}
    ] %}
  {% else %}
    {% set navItems = [
      {url: "/", label: "Inicio"},
      {url: "/servicios/", label: "Servicios"},
      {url: "/normativa/", label: "Normativa"},
      {url: "/sobre-tuaccesible/", label: "Sobre tuaccesible"},
      {url: "/equipo/", label: "Equipo"},
      {url: "/testimonios/", label: "Casos"},
      {url: "/contacto/", label: "Contacto"}
    ] %}
  {% endif %}

  <div class="lang-banner" id="lang-banner">
    <div class="wrap">
      <span id="lang-banner-text"></span>
      <span>
        <button type="button" id="lang-banner-switch">{% if lang == 'en' %}Switch language{% else %}Cambiar de idioma{% endif %}</button>
        <button type="button" id="lang-banner-dismiss">{% if lang == 'en' %}Stay in English{% else %}Quedarme en español{% endif %}</button>
      </span>
    </div>
  </div>

  <header class="site-header">
    <div class="wrap">
      <a class="wordmark" href="{% if lang == 'en' %}/en/{% else %}/{% endif %}">{% include "logo.njk" %}<span>tu<span class="mark">accesible</span></span></a>
      <nav class="main-nav" aria-label="{% if lang == 'en' %}Main{% else %}Principal{% endif %}">
        <ul>
          {% for item in navItems %}
          <li><a href="{{ item.url }}" {% if item.url == page.url %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </nav>
      <a class="lang-switch" id="lang-switch-link" href="{{ altUrl }}" lang="{% if lang == 'en' %}es{% else %}en{% endif %}">
        {% if lang == 'en' %}Español{% else %}English{% endif %}
      </a>
    </div>
  </header>

  <main id="contenido-principal">
    <div class="wrap">
      {{ content | safe }}
    </div>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p>tuaccesible.com — {% if lang == 'en' %}© 2026. Accessibility consulting.{% else %}© 2026. Consultoría en accesibilidad digital.{% endif %}</p>
      <p class="footer-links">
        <a href="{% if lang == 'en' %}/en/privacy/{% else %}/privacidad/{% endif %}">{% if lang == 'en' %}Privacy policy{% else %}Política de privacidad{% endif %}</a>
        <a href="{% if lang == 'en' %}/en/accessibility-statement/{% else %}/declaracion-accesibilidad/{% endif %}">{% if lang == 'en' %}Accessibility statement{% else %}Declaración de accesibilidad{% endif %}</a>
      </p>
    </div>
  </footer>

  <script src="/js/lang.js" defer></script>

  {# Analitica sin cookies. El archivo se sirve desde este dominio y no desde
     un servidor ajeno, para no abrir script-src a terceros. El pixel de
     respaldo solo se dibuja cuando no hay JavaScript, asi que nunca cuenta
     dos veces la misma visita. #}
  <script data-goatcounter="https://tuaccesible.goatcounter.com/count" async src="/js/count.js"></script>
  <noscript><img src="https://tuaccesible.goatcounter.com/count?p={{ page.url }}" alt="" width="1" height="1"></noscript>
</body>
</html>
